---
import { Menu } from "@lucide/astro";
import { sections } from "../constants/sections";
---

<header class="flex justify-center fixed w-full bg-primary-color p-4 z-20">
  <div class="max-w-5xl w-full">
    <nav class="hidden gap-4 text-xl md:flex">
      {
        sections.map((section) => (
          <a
            href={section.href}
            class="cursor-pointer hover:text-secondary-color hover:-translate-y-1.5 duration-300 ease-in-out"
          >
            {section.text}
          </a>
        ))
      }
    </nav>
    <button
      id="openSidebarButton"
      class="block hover:text-secondary-color cursor-pointer md:hidden"
    >
      <Menu size="1.5rem" />
    </button>
  </div>
</header>

<script>
  const $button = document.querySelector("#openSidebarButton");
  const OpenSidebarEvent = new CustomEvent("openSidebar");

  $button?.addEventListener("click", () => {
    window.dispatchEvent(OpenSidebarEvent);
  });
</script>
