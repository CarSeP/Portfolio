---
import { Menu, Moon, Sun } from "@lucide/astro";
import { sections } from "../constants/sections";
---

<header
  class="flex justify-center fixed w-full p-4 z-100 bg-linear-to-b from-background-base to-transparent"
>
  <div class="flex justify-between max-w-5xl w-full">
    <button
      id="openSidebarButton"
      class="block hover:text-accent-primary cursor-pointer md:hidden"
    >
      <Menu size="1.5rem" />
    </button>
    <button id="changeThemeButton" class="cursor-pointer">
      <span class="darkThemeIcon">
        <Moon />
      </span>
      <span class="lightThemeIcon">
        <Sun />
      </span>
    </button>
    <nav class="hidden gap-4 text-xl md:flex text-accent-secondary">
      {
        sections.map((section) => (
          <a
            href={section.href}
            class="cursor-pointer hover:text-accent-primary hover:-translate-y-1.5 duration-300 ease-in-out"
          >
            {section.text}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const $openSidebarButton = document.querySelector("#openSidebarButton");
  const $changeThemeButton = document.querySelector("#changeThemeButton");
  const OpenSidebarEvent = new CustomEvent("openSidebar");
  const ChangeThemeEvent = new CustomEvent("changeTheme");

  $openSidebarButton?.addEventListener("click", () => {
    window.dispatchEvent(OpenSidebarEvent);
  });

  $changeThemeButton?.addEventListener("click", () => {
    window.dispatchEvent(ChangeThemeEvent);
  });
</script>
