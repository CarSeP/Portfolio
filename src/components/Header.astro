---
import { sections } from "../constants/sections";
---

<header
  class="fixed top-0 left-0 w-full z-50 p-6 flex justify-center pointer-events-none"
>
  <nav
    class="pointer-events-auto glass-panel rounded-full px-8 py-3 flex items-center gap-8 shadow-2xl shadow-accent-primary/10"
  >
    <div class="hidden md:flex gap-6">
      {
        sections.map((section) => (
          <a
            href={section.href}
            class="text-sm font-medium text-text-secondary hover:text-accent-primary transition-colors uppercase tracking-widest"
          >
            {section.text}
          </a>
        ))
      }
    </div>
    <button id="openSidebarButton" class="md:hidden text-white">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><line x1="4" x2="20" y1="12" y2="12"></line><line
          x1="4"
          x2="20"
          y1="6"
          y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg
      >
    </button>
  </nav>
</header>

<script>
  const $openSidebarButton = document.querySelector("#openSidebarButton");
  const OpenSidebarEvent = new CustomEvent("openSidebar");

  $openSidebarButton?.addEventListener("click", () => {
    window.dispatchEvent(OpenSidebarEvent);
  });
</script>
