---
import Section from "./Section.astro";
import { skills } from "../constants/skills";
---

<Section name="skills">
  <div class="p-2 rounded-2xl bg-background-tertiary">
    <div
      id="categoriesContainer"
      class="flex rounded-2xl gap-1 p-1 w-full text-accent-secondary bg-background-secondary"
    >
      <button
        class="category font-bold rounded-xl p-2 w-full active cursor-pointer"
      >
        All
      </button>
      {
        skills.map((skill) => (
          <button class="category font-bold rounded-xl p-2 w-full cursor-pointer">
            {skill.group}
          </button>
        ))
      }
    </div>
    <div id="skillsContainer" class="flex flex-wrap justify-center gap-4 p-10">
      {
        skills.map((skill) =>
          skill.items.map((item) => (
            <article
              data-group={skill.group}
              class="px-4 py-1.5 rounded bg-background-secondary"
            >
              {item}
            </article>
          ))
        )
      }
    </div>
  </div>
</Section>

<style>
  .category:hover,
  .category.active {
    background-color: var(--color-accent-primary);
    color: var(--color-background-secondary);
  }
</style>

<script>
  const $container = document.querySelector("#categoriesContainer");
  const $skillsContainer = document.querySelector("#skillsContainer");

  $container?.querySelectorAll("button").forEach((button) => {
    button.addEventListener("click", () => {
      removeActiveCategories();
      button.classList.add("active");
      onChangeCategories(button.innerText);
    });
  });

  const onChangeCategories = (categories: string) => {
    $skillsContainer?.querySelectorAll("article").forEach((skills) => {
      if (
        categories === skills.getAttribute("data-group") ||
        categories === "All"
      ) {
        skills.style.display = "flex";
        return;
      }

      skills.style.display = "none";
    });
  };

  const removeActiveCategories = () => {
    $container?.querySelectorAll("button").forEach((button) => {
      button.classList.remove("active");
    });
  };
</script>
