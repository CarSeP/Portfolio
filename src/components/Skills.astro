---
import type { Skill } from "../interfaces/skill";

interface Props {
  skills: Skill[];
  title: string;
  subtitle: string;
}

const { skills, title, subtitle } = Astro.props;
---

<section id="skills" class="py-20">
  <div class="space-y-12">
    <div class="space-y-4">
      <h2 class="text-4xl md:text-5xl font-display font-bold">
        {title}
      </h2>
      <p class="text-text-secondary max-w-xl">
        {subtitle}
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        skills.map((category) => (
          <div class="glass-panel p-6 rounded-2xl space-y-6 hover:border-accent-primary/30 transition-colors duration-300">
            <h3 class="text-lg font-mono text-accent-primary border-b border-border-subtle pb-2">
              {category.group}
            </h3>
            <div class="flex flex-wrap gap-2">
              {category.items.map((item) => (
                <span class="px-3 py-1.5 text-sm bg-white/5 hover:bg-white/10 rounded-md border border-white/5 transition-colors cursor-default">
                  {item}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
