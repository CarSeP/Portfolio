---
import Section from "./Section.astro";
import { skills } from "../constants/skills";
---

<Section name="skills">
  <div
    id="categoriesContainer"
    class="flex justify-evenly rounded-t-2xl p-2 w-full bg-primary-color"
  >
    <button
      class="category active cursor-pointer border-b border-primary-color"
    >
      All
    </button>
    {
      skills.map((skill) => (
        <button class="category cursor-pointer border-b border-primary-color">
          {skill.group}
        </button>
      ))
    }
  </div>
  <div
    id="skillsContainer"
    class="flex flex-wrap justify-center gap-4 mt-4 p-6 rounded-b-2xl bg-primary-color"
  >
    {
      skills.map((skill) =>
        skill.items.map((item) => (
          <article
            data-group={skill.group}
            class="flex justify-center items-center size-24 rounded-xl bg-primary-bg"
          >
            {item}
          </article>
        ))
      )
    }
  </div>
</Section>

<style>
  .category:hover,
  .category.active {
    color: var(--color-secondary-color);
    border-color: var(--color-secondary-color);
  }
</style>

<script>
  const $container = document.querySelector("#categoriesContainer");
  const $skillsContainer = document.querySelector("#skillsContainer");

  $container?.querySelectorAll("button").forEach((button) => {
    button.addEventListener("click", () => {
      removeActiveCategories();
      button.classList.add("active");
      onChangeCategories(button.innerText);
    });
  });

  const onChangeCategories = (categories: string) => {
    $skillsContainer?.querySelectorAll("article").forEach((skills) => {
      if (
        categories === skills.getAttribute("data-group") ||
        categories === "All"
      ) {
        skills.style.display = "flex";
        return;
      }

      skills.style.display = "none";
    });
  };

  const removeActiveCategories = () => {
    $container?.querySelectorAll("button").forEach((button) => {
      button.classList.remove("active");
    });
  };
</script>
