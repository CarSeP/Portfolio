---
interface Props {
  text: string;
}
const { text } = Astro.props;
---

<div class="relative group inline-block">
  <slot />
  <div
    class="absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 w-max px-2 py-1 text-sm text-white bg-tertiary-color rounded shadow-lg invisible group-hover:visible opacity-0 group-hover:opacity-100 transition duration-300 z-10"
  >
    {text}
  </div>
</div>
