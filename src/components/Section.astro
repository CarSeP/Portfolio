---
import { sections } from "../constants/sections";

interface Props {
  name: string;
  hidden?: boolean;
}
const { name, hidden = false } = Astro.props;

const section = sections.find((el) => el.id === name);
---

{
  !hidden && (
    <section class="flex flex-col lg:block w-full" id={section?.id}>
      {section && section.id !== "home" && (
        <header class="flex items-center justify-center gap-4 p-20">
          <section.icon size="3rem" stroke-width="2.5" />
          <h2 class="text-5xl font-semibold section-title">{section.text}</h2>
        </header>
      )}
      <slot />
    </section>
  )
}

<style>
  .section-title {
    font-family: cursive;
  }
</style>
