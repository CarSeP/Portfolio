---
import { sections } from "../constants/sections";

interface Props {
  name: string;
}
const { name } = Astro.props;

const section = sections.find((el) => el.id === name);
---

<section class="flex flex-col lg:block w-full" id={section?.id}>
  {
    section && section.id !== "home" && (
      <header class="flex items-center justify-center gap-4 p-20">
        <section.icon size="2rem" />
        <h2 class="text-4xl">{section.text}</h2>
      </header>
    )
  }
  <slot />
</section>
