---
import Section from "./Section.astro";
import { experiences } from "../constants/experiences";
---

<Section name="experience">
  <div class="flex flex-col">
    {
      experiences.map((experience) => (
        <article class="w-full">
          <div class="absolute h-fit w-px bg-accent-primary translate-2" />
          <header class="flex items-center gap-4">
            <div class="flex z-10 justify-center items-center rounded-full size-4 bg-accent-primary">
              <div class="block rounded-full size-2 bg-background-secondary" />
            </div>
            <h3 class="text-2xl font-bold">{experience.title}</h3>
          </header>
          <div class="pl-8">
            <h4 class="py-2 text-accent-secondary">{experience.date}</h4>
            <p class="lg:text-xl text-tiny">{experience.description}</p>
            {experience.list && (
              <ul class="list-disc px-10 text-accent-secondary">
                {experience.list.map((item) => (
                  <li class="py-2">{item}</li>
                ))}
              </ul>
            )}
          </div>
        </article>
      ))
    }
  </div>
</Section>
