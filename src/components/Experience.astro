---
import Section from "./Section.astro";
import { experiences } from "../constants/experiences";
---

<Section name="experience">
  <div class="flex flex-col">
    {
      experiences.map((experience) => (
        <article class="grid">
          <div class="flex items-center gap-2">
            <div class="size-2 min-w-2 min-h-2 rounded-full bg-secondary-color" />
            <div class="flex items-end gap-2">
              <h3 class="text-2xl">{experience.title}</h3>
              <span class="text-tiny">{experience.date}</span>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <div class="flex justify-center min-w-2 h-full">
              <div class="w-1 h-full bg-secondary-color" />
            </div>
            <div>
              {experience.description.map((text) => (
                <p class="flex-1 lg:text-xl text-tiny py-2">{text}</p>
              ))}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</Section>
