---
import { X } from "@lucide/astro";
import type { Section } from "../interfaces/section";

interface Props {
  sections: Section[];
  lang: string;
}

const { sections, lang } = Astro.props;
---

<aside
  id="sidebar"
  class="fixed inset-y-0 right-0 w-64 bg-background-surface/90 backdrop-blur-xl border-l border-white/10 transform translate-x-full transition-transform duration-300 ease-in-out z-100 lg:hidden"
>
  <div class="p-6 h-full flex flex-col">
    <div class="flex justify-end mb-8">
      <button
        id="closeSidebarButton"
        class="p-2 text-text-secondary hover:text-white transition-colors"
      >
        <X size={24} />
      </button>
    </div>
    <nav class="flex flex-col gap-2">
      {
        sections.map((section) => (
          <a
            href={section.href}
            class="flex items-center gap-4 p-4 rounded-lg text-lg font-medium text-text-secondary hover:text-white hover:bg-white/5 transition-all group"
          >
            <section.icon
              size={20}
              class="group-hover:text-accent-primary transition-colors"
            />
            {section.text}
          </a>
        ))
      }
      <div class="mt-8 pt-8 border-t border-white/10 flex flex-col gap-4">
        <div class="flex gap-2 px-2">
          <a
            href="/en"
            class={`flex-1 text-center p-3 rounded-lg border border-white/5 transition-all ${lang === "en" ? "bg-accent-secondary/10 text-accent-secondary border-accent-secondary/20" : "text-text-secondary hover:bg-white/5"}`}
          >
            English
          </a>
          <a
            href="/es"
            class={`flex-1 text-center p-3 rounded-lg border border-white/5 transition-all ${lang === "es" ? "bg-accent-primary/10 text-accent-primary border-accent-primary/20" : "text-text-secondary hover:bg-white/5"}`}
          >
            Español
          </a>
        </div>
      </div>
    </nav>
  </div>
</aside>
<div
  id="sidebarOverlay"
  class="fixed inset-0 bg-black/60 backdrop-blur-sm z-90 opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
>
</div>

<script>
  const sidebar = document.getElementById("sidebar");
  const overlay = document.getElementById("sidebarOverlay");
  const closeBtn = document.getElementById("closeSidebarButton");
  const anchors = sidebar?.querySelectorAll("a");

  function toggleSidebar(show: boolean) {
    if (show) {
      sidebar?.classList.remove("translate-x-full");
      overlay?.classList.remove("opacity-0", "pointer-events-none");
      document.body.style.overflow = "hidden";
    } else {
      sidebar?.classList.add("translate-x-full");
      overlay?.classList.add("opacity-0", "pointer-events-none");
      document.body.style.overflow = "";
    }
  }

  window.addEventListener("openSidebar", () => toggleSidebar(true));
  closeBtn?.addEventListener("click", () => toggleSidebar(false));
  overlay?.addEventListener("click", () => toggleSidebar(false));

  anchors?.forEach((a) => {
    a.addEventListener("click", () => toggleSidebar(false));
  });
</script>
