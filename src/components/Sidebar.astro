---
import { X } from "@lucide/astro";
import { sections } from "../constants/sections";
---

<aside
  id="sidebar"
  class="hidden p-4 fixed w-full xs:max-w-[260px] h-dvh z-101 text-text-primary bg-special-primary md:hidden"
>
  <button
    id="closeSidebarButton"
    class="block hover:text-accent-primary cursor-pointer md:hidden"
  >
    <X size="1.5rem" />
  </button>
  <nav class="flex flex-col pt-8">
    {
      sections.map((section) => (
        <a
          href={section.href}
          class="flex gap-2 p-4 cursor-pointer font-bold hover:text-accent-primary hover:bg-special-secondary"
        >
          <section.icon size="1.5rem" />
          {section.text}
        </a>
      ))
    }
  </nav>
</aside>

<script>
  const $sidebar = document.querySelector("#sidebar");
  const $button = document.querySelector("#closeSidebarButton");
  const $anchors = $sidebar?.querySelectorAll("a");

  const handleOpenSidebar = (open: boolean) => {
    if (open) {
      $sidebar?.classList.remove("hidden");
      return;
    }
    $sidebar?.classList.add("hidden");
  };

  $anchors?.forEach((anchor) => {
    anchor.addEventListener("click", () => {
      handleOpenSidebar(false);
    });
  });

  $button?.addEventListener("click", () => {
    handleOpenSidebar(false);
  });

  window.addEventListener("openSidebar", () => {
    handleOpenSidebar(true);
  });
</script>
