---
import Section from "./Section.astro";
import { info } from "../constants/info";
import { Github, Linkedin, Mail } from "@lucide/astro";
---

<Section name="home">
  <div class="flex items-center min-h-screen py-40">
    <div>
      <h1 class="text-4xl font-bold text-secondary-color">
        {info.name}
      </h1>
      <span class="block text-2xl my-6">
        {info.description}
      </span>
      <div class="flex gap-2">
        <a href={info.urls.github} target="_blank">
          <button
            class="flex items-center gap-1 font-semibold px-4 py-1.5 cursor-pointer rounded-xl bg-primary-color hover:bg-tertiary-color"
          >
            <Github size={"1.25rem"} />
            Github
          </button></a
        >
        <a href={info.urls.linkedin} target="_blank">
          <button
            class="flex items-center gap-1 font-semibold px-4 py-1.5 cursor-pointer rounded-xl bg-primary-color hover:bg-tertiary-color"
          >
            <Linkedin size={"1.25rem"} />
            Linkedin
          </button>
        </a>
        <a href={`mailto:${info.mail}`}>
          <button
            class="flex items-center gap-1 font-semibold px-4 py-1.5 cursor-pointer rounded-xl bg-primary-color hover:bg-tertiary-color"
          >
            <Mail size={"1.25rem"} />
            Mail
          </button>
        </a>
      </div>
    </div>
  </div>
</Section>
