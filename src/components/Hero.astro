---
import { info } from "../constants/info";
import { Github, Linkedin, Mail, ArrowDown } from "@lucide/astro";
---

<section
  id="home"
  class="relative min-h-screen flex items-center justify-center overflow-hidden"
>
  <div class="absolute inset-0 z-0">
    <div
      class="absolute top-1/4 left-1/4 w-[500px] h-[500px] bg-accent-secondary/20 rounded-full blur-[120px] animate-pulse"
    >
    </div>
    <div
      class="absolute bottom-1/4 right-1/4 w-[500px] h-[500px] bg-accent-primary/10 rounded-full blur-[120px] animate-pulse delay-1000"
    >
    </div>
  </div>
  <div
    class="relative z-10 max-w-7xl w-full px-6 flex flex-col md:flex-row items-center gap-12"
  >
    <div class="flex-1 space-y-8 animate-[fade-in_1s_ease-out]">
      <h1
        class="text-6xl md:text-8xl font-display font-bold leading-[0.9] tracking-tight"
      >
        {info.name}
      </h1>
      <p
        class="text-xl md:text-2xl text-text-secondary max-w-xl leading-relaxed"
      >
        {info.description}.
      </p>
      <div class="flex flex-wrap gap-4 pt-4">
        <a
          href="#projects"
          class="px-8 py-4 bg-white text-black font-bold rounded-lg hover:bg-accent-primary hover:scale-105 transition-all duration-300"
        >
          View Projects
        </a>
        <a
          href={info.urls.github}
          target="_blank"
          class="px-8 py-4 glass-panel text-white font-bold rounded-lg hover:bg-white/10 transition-all duration-300 flex items-center gap-2"
        >
          <Github size={20} />
          GitHub
        </a>
        <a
          href={info.urls.linkedin}
          target="_blank"
          class="p-4 glass-panel text-white rounded-lg hover:bg-white/10 transition-all duration-300"
        >
          <Linkedin size={20} />
        </a>
      </div>
    </div>
    <div
      class="flex-1 w-full flex justify-center md:justify-end animate-[slide-up_1s_ease-out_0.3s_both]"
    >
      <div
        class="relative w-full max-w-md aspect-square rounded-2xl overflow-hidden glass-panel p-2 rotate-3 hover:rotate-0 transition-transform duration-500"
      >
        <div
          class="w-full h-full bg-linear-to-br from-background-surface to-background-base rounded-xl border border-border-subtle flex items-center justify-center relative overflow-hidden group"
        >
          <div
            class="absolute inset-0 opacity-20"
            style="background-image: linear-gradient(#333 1px, transparent 1px), linear-gradient(90deg, #333 1px, transparent 1px); background-size: 20px 20px;"
          >
          </div>
          <div
            class="text-9xl font-display font-bold text-accent-primary/10 group-hover:text-accent-primary/20 transition-colors duration-500 select-none"
          >
          </div>
        </div>
      </div>
    </div>
  </div>
  <div
    class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 animate-bounce opacity-50"
  >
    <span class="text-xs font-mono uppercase tracking-widest text-text-muted"
      >Scroll</span
    >
    <ArrowDown size={16} />
  </div>
</section>
