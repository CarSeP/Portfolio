---
import type { Project } from "../interfaces/projects";

interface Props {
  projects: Project[];
  title: string;
  subtitle: string;
  description: string;
  technologies: string;
}
const { projects, title, subtitle, description, technologies } = Astro.props;
---

<section id="projects" class="relative py-20">
  <div class="flex flex-col gap-12">
    <div class="space-y-4">
      <h2 class="text-4xl md:text-5xl font-display font-bold">{title}</h2>
      <p class="text-text-secondary max-w-xl">
        {subtitle}
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        projects.map((project) => (
          <article
            class="project-item cursor-pointer group relative rounded-2xl overflow-hidden glass-panel border border-border-subtle hover:border-accent-primary/50 transition-colors duration-500"
            data-title={project.title}
            data-img={project.img}
            data-description={project.content.join("\n\n")}
            data-technologies={JSON.stringify(project.technologies)}
          >
            <div class="absolute inset-0 bg-linear-to-t from-background-base via-transparent to-transparent opacity-80 z-10 pointer-events-none" />
            <div class="relative z-20 p-8 h-full flex flex-col justify-end gap-6">
              <div class="h-full space-y-4 transition-transform duration-500">
                <div class="flex flex-wrap justify-between items-start gap-4">
                  <h3 class="text-3xl font-display font-bold group-hover:text-accent-primary transition-colors">
                    {project.title}
                  </h3>
                  <div class="flex gap-3 transition-opacity duration-300">
                    {project.links.map((link) => (
                      <a
                        href={link.url}
                        target="_blank"
                        class="p-2 bg-white/10 rounded-full hover:bg-accent-primary hover:text-black transition-colors"
                        title={link.title}
                      >
                        <link.icon size={20} />
                      </a>
                    ))}
                  </div>
                </div>
                <div class="space-y-4 max-h-40 opacity-100 transition-all duration-500 ease-out">
                  <p
                    title={project.content[0]}
                    class="text-text-secondary leading-relaxed line-clamp-3"
                  >
                    {project.content[0]}
                  </p>
                </div>
                <div class="flex flex-wrap gap-2">
                  {project.technologies.map((tech) => (
                    <span class="px-3 py-1 text-xs font-mono border border-white/20 rounded-full text-text-secondary">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
  <div
    id="project-lightbox"
    class="fixed inset-0 z-100 bg-background-base/95 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-500 flex items-center justify-center p-4 md:p-8"
  >
    <button
      id="close-project-lightbox"
      class="cursor-pointer absolute top-6 right-6 p-3 rounded-full glass-panel hover:bg-white/10 transition-colors z-10"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg
      >
    </button>
    <div
      class="relative max-w-3xl w-full flex flex-col gap-8 bg-background-surface/50 p-6 md:p-10 rounded-3xl border border-white/10 glass-panel overflow-y-auto max-h-[90vh]"
    >
      <div class="space-y-6">
        <h2
          id="project-lightbox-title"
          class="text-3xl md:text-4xl font-display font-bold text-accent-primary"
        >
        </h2>

        <div class="space-y-3">
          <h4
            class="text-xs font-mono text-text-muted uppercase tracking-widest font-semibold"
          >
            {technologies}
          </h4>
          <div id="project-lightbox-tech" class="flex flex-wrap gap-2"></div>
        </div>
      </div>

      <div
        class="w-full aspect-video overflow-hidden rounded-xl bg-white/5 shrink-0"
      >
        <img
          id="project-lightbox-img"
          src=""
          alt=""
          class="w-full h-full object-cover transform scale-95 transition-transform duration-500"
        />
      </div>

      <div class="space-y-3">
        <h4
          class="text-xs font-mono text-text-muted uppercase tracking-widest font-semibold"
        >
          {description}
        </h4>
        <p
          id="project-lightbox-description"
          class="text-text-secondary leading-relaxed whitespace-pre-line"
        >
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const $lightbox = document.getElementById("project-lightbox");
  const $lightboxImg = document.getElementById(
    "project-lightbox-img",
  ) as HTMLImageElement;
  const $lightboxTitle = document.getElementById("project-lightbox-title");
  const $lightboxDesc = document.getElementById("project-lightbox-description");
  const $lightboxTech = document.getElementById("project-lightbox-tech");
  const $closeBtn = document.getElementById("close-project-lightbox");
  const $projectItems = document.querySelectorAll(".project-item");

  function openLightbox(
    img: string,
    title: string,
    desc: string,
    tech: string[],
  ) {
    if (
      !$lightbox ||
      !$lightboxImg ||
      !$lightboxTitle ||
      !$lightboxDesc ||
      !$lightboxTech
    )
      return;

    $lightboxTitle.textContent = title;
    $lightboxDesc.textContent = desc;
    $lightboxImg.src = img;

    if (!$lightboxImg.parentElement) return;

    if (!img) {
      $lightboxImg.parentElement.style.display = "none";
    } else {
      $lightboxImg.parentElement.style.display = "block";
    }

    $lightboxTech.innerHTML = "";
    tech.forEach((t) => {
      const span = document.createElement("span");
      span.className =
        "px-3 py-1 text-xs font-mono border border-white/20 rounded-full text-text-secondary";
      span.textContent = t;
      $lightboxTech.appendChild(span);
    });

    $lightbox.classList.remove("opacity-0", "pointer-events-none");
    setTimeout(() => {
      $lightboxImg.classList.remove("scale-95");
      $lightboxImg.classList.add("scale-100");
    }, 10);
    document.body.style.overflow = "hidden";
  }

  function closeLightbox() {
    if (!$lightbox || !$lightboxImg) return;

    $lightboxImg.classList.remove("scale-100");
    $lightboxImg.classList.add("scale-95");
    $lightbox.classList.add("opacity-0", "pointer-events-none");
    document.body.style.overflow = "";

    setTimeout(() => {
      const scrollableContent = $lightbox.querySelector("div.overflow-y-auto");
      if (scrollableContent) {
        scrollableContent.scrollTop = 0;
      }
    }, 500);
  }

  $projectItems.forEach((item) => {
    item.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) return;

      const img = item.getAttribute("data-img") || "";
      const title = item.getAttribute("data-title") || "";
      const desc = item.getAttribute("data-description") || "";
      const tech = JSON.parse(item.getAttribute("data-technologies") || "[]");
      openLightbox(img, title, desc, tech);
    });
  });

  $closeBtn?.addEventListener("click", closeLightbox);
  $lightbox?.addEventListener("click", (e) => {
    if (e.target === $lightbox) closeLightbox();
  });

  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeLightbox();
  });
</script>
