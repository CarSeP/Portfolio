---
import Section from "./Section.astro";
import { projects } from "../constants/projects";
---

<Section name="projects">
  <div class="flex items-center flex-col gap-24 w-full">
    {
      projects.map((project) => (
        <article class="flex gap-16 flex-col-reverse lg:flex-row lg:max-w-5xl lg:h-96 w-full max-w-md rounded-2xl p-6 overflow-y-hidden bg-background-secondary">
          <div class="flex flex-col flex-1 h-full overflow-hidden">
            <header class="flex justify-between">
              <h3 class="text-3xl font-bold">{project.title}</h3>
            </header>
            <div class="flex flex-wrap gap-2 pt-4">
              {project.technologies.map((technology) => (
                <span class="py-1 px-2 text-tiny rounded-full bg-badge-background text-badge-text">
                  {technology}
                </span>
              ))}
            </div>
            <div class="lg:text-xl text-tiny text-accent-secondary">
              {project.content.map((paragraph) => (
                <p class="pt-4">{paragraph}</p>
              ))}
            </div>
          </div>
          <picture class="aspect-square rounded-xl bg-background-base">
            <div class="relative flex justify-end gap-2 p-4">
              {project.links.map((link) => (
                <span class="cursor-pointer">
                  <link.icon size="1.25rem" />
                </span>
              ))}
            </div>
          </picture>
        </article>
      ))
    }
  </div>
</Section>
