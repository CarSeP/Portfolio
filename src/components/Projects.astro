---
import Section from "./Section.astro";
import { projects } from "../constants/projects";
---

<Section name="projects">
  <div class="flex items-center flex-col gap-10 w-full">
    {
      projects.map((project) => (
        <article class="flex gap-4 flex-col-reverse lg:flex-row lg:max-w-5xl lg:h-96 w-full max-w-md rounded-2xl p-6 bg-primary-color">
          <div class="flex flex-col flex-1 h-full">
            <header class="flex justify-between">
              <h3 class="text-2xl">{project.title}</h3>
            </header>
            <div class="flex-1 lg:text-xl text-tiny">
              {project.content.map((paragraph) => (
                <p class="pt-4">{paragraph}</p>
              ))}
            </div>
            <footer class="flex gap-2 pt-4">
              {project.technologies.map((technology) => (
                <span class="text-secondary-color">{technology}</span>
              ))}
            </footer>
          </div>
          <picture class="aspect-square rounded-xl bg-primary-bg">
            <div class="relative flex justify-end gap-2 p-4">
              {project.links.map((link) => (
                <span class="cursor-pointer">
                  <link.icon size="1.25rem" />
                </span>
              ))}
            </div>
          </picture>
        </article>
      ))
    }
  </div>
</Section>
