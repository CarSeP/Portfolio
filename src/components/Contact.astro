---
import { Mail, ArrowRight } from "@lucide/astro";
import type { Info } from "../interfaces/info";

interface Props {
  info: Info;
  title: string;
  subtitle: string;
  buttonText: string;
  copiedText: string;
}

const { info, title, subtitle, buttonText, copiedText } = Astro.props;
---

<section id="contact" class="py-32 relative overflow-hidden">
  <div
    class="absolute right-0 bottom-0 w-96 h-96 bg-accent-primary/5 rounded-full blur-[100px] pointer-events-none"
  >
  </div>
  <div
    class="glass-panel p-12 md:p-20 rounded-3xl relative overflow-hidden text-center space-y-12"
  >
    <div class="space-y-6 relative z-10">
      <h2 class="text-5xl md:text-7xl font-display font-bold tracking-tight">
        {title}<br />
        <span class="text-accent-primary">{subtitle}</span>
      </h2>
    </div>
    <div
      class="flex flex-col md:flex-row items-center justify-center gap-6 relative z-10"
    >
      <a
        href={`mailto:${info.mail}`}
        class="group flex items-center gap-3 px-8 py-4 bg-white text-black rounded-full font-bold hover:bg-accent-primary transition-all duration-300 hover:scale-105"
      >
        <Mail size={20} />
        <span>{buttonText}</span>
        <ArrowRight
          size={20}
          class="group-hover:translate-x-1 transition-transform"
        />
      </a>
      <button
        id="copyEmail"
        data-email={info.mail}
        class="cursor-pointer px-8 py-4 rounded-full border border-white/20 hover:bg-white/10 transition-colors font-mono text-sm"
        data-copied={copiedText}
      >
        {info.mail}
      </button>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById("copyEmail");

  copyBtn?.addEventListener("click", () => {
    const email = copyBtn.getAttribute("data-email");
    if (email) {
      navigator.clipboard.writeText(email);
      const originalText = copyBtn.innerText;
      copyBtn.innerText = copyBtn.dataset.copied ?? "";
      copyBtn.classList.add("text-accent-primary", "border-accent-primary");

      setTimeout(() => {
        copyBtn.innerText = originalText;
        copyBtn.classList.remove(
          "text-accent-primary",
          "border-accent-primary",
        );
      }, 2000);
    }
  });
</script>
