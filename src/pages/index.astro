---
import Layout from "../components/Layout.astro";
---

<Layout title="Portfolio">
  <main
    class="relative min-h-screen flex items-center justify-center overflow-hidden bg-background-base"
  >
    <div class="absolute inset-0 z-0">
      <div
        class="absolute top-1/4 left-1/4 w-[500px] h-[500px] bg-accent-secondary/15 rounded-full blur-[120px] animate-pulse"
      >
      </div>
      <div
        class="absolute bottom-1/4 right-1/4 w-[500px] h-[500px] bg-accent-primary/10 rounded-full blur-[120px] animate-pulse delay-1000"
      >
      </div>
    </div>
    <div
      class="relative z-10 w-full max-w-4xl px-6 flex flex-col items-center gap-16"
    >
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 w-full max-w-2xl">
        <a
          href="/en"
          class="group relative flex flex-col items-center justify-center p-12 rounded-2xl glass-panel border border-border-subtle hover:border-accent-secondary/50 transition-all duration-500 hover:scale-[1.02] hover:-translate-y-2 animate-[slide-up_1s_ease-out_0.2s_both]"
        >
          <div
            class="absolute inset-0 bg-accent-secondary/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500 rounded-2xl"
          >
          </div>
          <span
            class="text-6xl mb-6 font-display font-bold text-text-muted group-hover:text-accent-secondary transition-colors duration-500"
            >EN</span
          >
          <h2
            class="text-2xl font-display font-bold group-hover:glow-text transition-all duration-500"
          >
            English
          </h2>
          <div
            class="absolute bottom-4 right-4 opacity-0 group-hover:opacity-100 transition-all duration-500 translate-x-4 group-hover:translate-x-0"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-accent-secondary"
              ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
            >
          </div>
        </a>
        <a
          href="/es"
          class="group relative flex flex-col items-center justify-center p-12 rounded-2xl glass-panel border border-border-subtle hover:border-accent-primary/50 transition-all duration-500 hover:scale-[1.02] hover:-translate-y-2 animate-[slide-up_1s_ease-out_0.4s_both]"
        >
          <div
            class="absolute inset-0 bg-accent-primary/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500 rounded-2xl"
          >
          </div>
          <span
            class="text-6xl mb-6 font-display font-bold text-text-muted group-hover:text-accent-primary transition-colors duration-500"
            >ES</span
          >
          <h2
            class="text-2xl font-display font-bold group-hover:glow-text transition-all duration-500"
          >
            Español
          </h2>
          <div
            class="absolute bottom-4 right-4 opacity-0 group-hover:opacity-100 transition-all duration-500 translate-x-4 group-hover:translate-x-0"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-accent-primary"
              ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
            >
          </div>
        </a>
      </div>
    </div>
  </main>
</Layout>

<script is:inline>
  const lang = navigator.language || navigator.userLanguage || '';
  const redirect = lang.toLowerCase().startsWith('es') ? '/es' : '/en';
  window.location.href = redirect;
</script>

<style>
  .group:hover .glow-text {
    text-shadow: 0 0 20px rgba(204, 255, 0, 0.3);
  }
  .group:hover .text-accent-secondary.glow-text {
    text-shadow: 0 0 20px rgba(124, 58, 237, 0.3);
  }
</style>