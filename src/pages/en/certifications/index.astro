---
import { certifications } from "../../../constants/en/certifications";
import { Image } from "astro:assets";
import Layout from "../../../components/Layout.astro";
import Footer from "../../../components/Footer.astro";
import { info } from "../../../constants/en/info";
import { ArrowLeft, ZoomIn } from "@lucide/astro";

const lang = "en";
---

<Layout title="Certifications | Portfolio">
  <div class="flex flex-col min-h-screen">
    <main class="flex-1 w-full pt-32 pb-20 px-6">
      <div class="max-w-7xl mx-auto">
        <div
          class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-12 animate-fade-in"
        >
          <div>
            <a
              href={`/${lang}`}
              class="inline-flex items-center gap-2 text-text-secondary hover:text-accent-primary transition-colors mb-4 group"
            >
              <ArrowLeft
                size={18}
                class="group-hover:-translate-x-1 transition-transform"
              />
              <span class="font-mono text-sm uppercase tracking-wider"
                >Back to Home</span
              >
            </a>
            <h1 class="text-4xl md:text-5xl font-display font-bold">
              Certifications & Awards
            </h1>
            <p class="text-text-secondary mt-2 max-w-2xl">
              A record of my professional growth, technical validations, and
              academic achievements.
            </p>
          </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {
            certifications.map((cert, index) => (
              <div
                class="group glass-panel rounded-2xl overflow-hidden hover:border-accent-primary/30 transition-all duration-500 animate-slide-up cursor-pointer cert-item"
                style={`animation-delay: ${index * 0.1}s`}
                data-img={cert.img}
                data-title={cert.title}
              >
                <div class="relative aspect-4/3 overflow-hidden bg-white/5">
                  <Image
                    src={cert.img}
                    alt={cert.title}
                    width={600}
                    height={450}
                    class="object-cover w-full h-full group-hover:scale-110 transition-transform duration-700"
                  />
                  <div class="absolute inset-0 bg-background-base/60 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-center justify-center">
                    <div class="bg-accent-primary text-background-base p-3 rounded-full scale-50 group-hover:scale-100 transition-transform duration-500">
                      <ZoomIn size={24} />
                    </div>
                  </div>
                </div>
                <div class="p-6">
                  <h3 class="text-lg font-display font-semibold group-hover:text-accent-primary transition-colors">
                    {cert.title}
                  </h3>
                  <div class="mt-4 flex items-center justify-between">
                    <span class="text-xs font-mono text-text-muted uppercase tracking-widest">
                      Verification
                    </span>
                    <div class="h-px flex-1 mx-4 bg-white/5" />
                    <span class="text-accent-primary opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <>
                          <path d="M5 12h14" />
                          <path d="m12 5 7 7-7 7" />
                        </>
                      </svg>
                    </span>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </main>
    <div
      id="lightbox"
      class="fixed inset-0 z-100 bg-background-base/95 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-500 flex items-center justify-center p-4 md:p-8"
    >
      <button
        id="closeLightbox"
        class="cursor-pointer absolute top-6 right-6 p-3 rounded-full glass-panel hover:bg-white/10 transition-colors z-10"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg
        >
      </button>
      <div class="relative max-w-5xl w-full flex flex-col items-center">
        <img
          id="lightboxImg"
          src=""
          alt=""
          class="max-h-[80vh] w-auto rounded-lg shadow-2xl border border-white/10 transform scale-95 transition-transform duration-500"
        />
        <div class="mt-6 text-center">
          <h2 id="lightboxTitle" class="text-2xl font-display font-bold"></h2>
        </div>
      </div>
    </div>
    <Footer info={info} buttonText="Source Code" />
  </div>
</Layout>

<script>
  const $lightbox = document.getElementById("lightbox");
  const $lightboxImg = document.getElementById(
    "lightboxImg",
  ) as HTMLImageElement;
  const $lightboxTitle = document.getElementById("lightboxTitle");
  const $closeBtn = document.getElementById("closeLightbox");
  const $certItems = document.querySelectorAll(".cert-item");

  function openLightbox(img: string, title: string) {
    if (!$lightbox || !$lightboxImg || !$lightboxTitle) return;

    $lightboxImg.src = img;
    $lightboxTitle.textContent = title;

    $lightbox.classList.remove("opacity-0", "pointer-events-none");
    setTimeout(() => {
      $lightboxImg.classList.remove("scale-95");
      $lightboxImg.classList.add("scale-100");
    }, 10);
    document.body.style.overflow = "hidden";
  }

  function closeLightbox() {
    if (!$lightbox || !$lightboxImg) return;

    $lightboxImg.classList.remove("scale-100");
    $lightboxImg.classList.add("scale-95");
    $lightbox.classList.add("opacity-0", "pointer-events-none");
    document.body.style.overflow = "";
  }

  $certItems.forEach((item) => {
    item.addEventListener("click", () => {
      const img = item.getAttribute("data-img") || "";
      const title = item.getAttribute("data-title") || "";
      openLightbox(img, title);
    });
  });

  $closeBtn?.addEventListener("click", closeLightbox);
  $lightbox?.addEventListener("click", (e) => {
    if (e.target === $lightbox) closeLightbox();
  });

  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeLightbox();
  });
</script>

<style>
  .glass-panel {
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
</style>
