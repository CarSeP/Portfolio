---
import Certifications from "../../components/Certifications.astro";
import Contact from "../../components/Contact.astro";
import Experience from "../../components/Experience.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import Hero from "../../components/Hero.astro";
import Layout from "../../components/Layout.astro";
import Projects from "../../components/Projects.astro";
import Sidebar from "../../components/Sidebar.astro";
import Skills from "../../components/Skills.astro";
import { info } from "../../constants/es/info";
import { projects } from "../../constants/es/projects";
import { experiences } from "../../constants/es/experiences";
import { skills } from "../../constants/es/skills";
import { sections } from "../../constants/es/sections";
---

<Layout title="Portfolio">
  <Sidebar sections={sections} lang="es" />
  <div class="flex flex-col min-h-screen">
    <Header sections={sections} lang="es" />
    <main class="flex-1 w-full overflow-hidden">
      <Hero info={info} buttonText="Ver Proyectos" />
      <div class="max-w-7xl mx-auto px-6 w-full space-y-32 pb-32">
        <Projects
          projects={projects}
          title="Trabajos seleccionados"
          subtitle="Una recopilación de proyectos que definen mi enfoque para la resolución de problemas digitales."
          description="Descripción"
          technologies="Tecnologías"
        />
        <Experience
          experiences={experiences}
          title="Experiencia"
          subtitle="Mi trayectoria profesional en ingeniería de software."
        />
        <Skills
          skills={skills}
          title="Habilidades técnicas"
          subtitle="Las herramientas y tecnologías que utilizo para dar vida a mis ideas"
        />
        <Certifications
          title="Certificaciones y premios"
          subtitle="Consulta mis cualificaciones profesionales y mis logros."
          buttonText="Ver todo"
          lang="es"
        />
        <Contact
          info={info}
          title="¿Te gustaría"
          subtitle="contactarme?"
          buttonText="Enviame un correo"
          copiedText="¡Copiado!"
        />
      </div>
    </main>
    <Footer info={info} buttonText="Código fuente" />
  </div>
</Layout>
